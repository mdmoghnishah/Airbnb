<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>whanderLust</title>
</head>
<body>
    <h3>Create a new Listing</h3>
    <form method="POST" action="/listings">
        <input name="listing[title]" placeholder="enter the title">
        <br/><br/>
        <textarea name="listing[description]" placeholder="enter the description"></textarea>
        <br/><br/>
        <input name="listing[image]" placeholder="enter the price" type="text">
        <br/><br/>
        <input name="listing[price]" placeholder="enter the price" type="number">
        <br/><br/>
        <input name="listing[location]" placeholder="enter the title" type="text">
        <br/><br/>
        <input name="listing[country]" placeholder="enter the title" type="text">
        <br/><br/>
        <button>Add</button>

    </form>
    
</body>
</html>